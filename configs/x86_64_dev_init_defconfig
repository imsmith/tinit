# tinit dev target: x86_64, musl, initramfs, QEMU. Paths are relative to buildroot/.
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"

BR2_INIT_NONE=y
# No shell, no busybox: tinit, ERTS, the sysbeam release and tclsh are the userland.
# BR2_PACKAGE_BUSYBOX is not set
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_ROOTFS_OVERLAY="../dev_tinit/rootfs_overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="../dev_tinit/post-build.sh"
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_18=y
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/x86_64/linux.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="../dev_tinit/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# sysbeam runtime: OTP 26 from Buildroot; Elixir is unzipped by post-build.sh
BR2_PACKAGE_ERLANG=y

# ltd config files are Tcl; ltd evaluates them with tclsh
BR2_PACKAGE_TCL=y
# BR2_PACKAGE_TCL_SHLIB_ONLY is not set

# /init in the cpio is a symlink to tinit, not Buildroot's sh pre-init script.
# The static table provides /dev/console, /dev/null and /dev/ttyS0; ltd mounts devtmpfs over it.
BR2_ROOTFS_DEVICE_CREATION_STATIC=y
