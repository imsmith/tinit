# Target Architecture
BR2_i386_64=y

# Toolchain (Using internal toolchain for portability)
BR2_arm_cortexa7a_vfpv3=n
BR2_USE_ Musl=y
BR2_arm_cortexa7a_vfpv3=n
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

# System Configuration
BR2_INIT_BUSYBOX=y
# This is where your magic happens:
BR2_ROOTFS_OVERLAY="/path/to/your/init_overlay"

# Filesystem (Using cpio for Initramfs - fastest for dev)
# Using initramfs means you don't need to deal with partitions/disk images
BR2_TARGET_ROOTFS_CPIO=y

# Kernel
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="configs/defconfig"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG_CONTENT=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_CONTENT="
# Minimal kernel config for QEMU
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_PIXELS=n
CONFIG_BLK_DEV_SD=y
CONFIG_EXT4_FS=y
"
