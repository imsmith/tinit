#!/bin/sh
# ltd: stage-1 boot sequencer. tinit (PID 1) forks this and respawns it if it dies.
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev

echo "========================================"
echo " tinit PID 1 -> ltd PID $$"
echo " $(cat /proc/version)"
echo "========================================"
echo "ps -o pid,ppid,comm  # tinit is PID 1. Type 'exit' and ltd respawns."

exec setsid /bin/sh -c 'exec /bin/sh </dev/ttyS0 >/dev/ttyS0 2>&1'
