; sysbeam SELinux policy (CIL). The trusted base (kernel, tinit, ltd, easysec) runs as kernel_t
; and is unconfined. Workers are confined by the domain easysec gives them through sbexec -x:
;   admin_t   may read and write files (console workers that edit config)
;   worker_t  may only read
; Nobody below kernel_t may load policy or change enforcing. Only the classes declared here are
; checked; everything else is allowed (handleunknown allow). Compiled by secilc at build time.
(handleunknown allow)
(mls false)
(policycap open_perms)
(policycap nnp_nosuid_transition)
(policycap cgroup_seclabel)

(sensitivity s0)
(sensitivityorder (s0))
(level lvl (s0))
(levelrange lr (lvl lvl))
(user u)
(role r)
(role object_r)
(userrole u r)
(userrole u object_r)
(userlevel u lvl)
(userrange u lr)

(common file (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads watch_mountns))
(class file (execute_no_trans entrypoint))
(classcommon file file)
(class dir (add_name remove_name reparent search rmdir))
(classcommon dir file)
(class process (fork transition sigchld sigkill sigstop signull signal ptrace getsched setsched getsession getpgid setpgid getcap setcap share getattr setexec setfscreate noatsecure siginh setrlimit rlimitinh dyntransition setcurrent execmem execstack execheap setkeycreate setsockcreate getrlimit))
(class process2 (nnp_transition nosuid_transition))
(class security (compute_av compute_create compute_member check_context load_policy compute_relabel compute_user setenforce setbool setsecparam setcheckreqprot read_policy validate_trans))
(classorder (file dir process process2 security))

(type kernel_t)
(type admin_t)
(type worker_t)
(type unlabeled_t)
(type security_t)
(type root_t)
(type proc_t)
(type sysfs_t)
(type cgroup_t)
(type dev_t)
(type tmp_t)
(type boot_t)
(typeattribute domain)
(typeattributeset domain (kernel_t admin_t worker_t))
(typeattribute anything)
(typeattributeset anything (all))
(roletype r domain)
(roletype object_r anything)

; the trusted base
(allow kernel_t anything (file (all)))
(allow kernel_t anything (dir (all)))
(allow kernel_t anything (process (all)))
(allow kernel_t anything (process2 (all)))
(allow kernel_t security_t (security (all)))

; workers: entered from kernel_t by sbexec (setexec, then exec of beam.smp under no_new_privs)
(allow domain self (process (all)))
(allow domain self (process2 (all)))
(allow admin_t anything (file (all)))
(allow admin_t anything (dir (all)))
(allow worker_t anything (file (ioctl read getattr lock map execute execute_no_trans open entrypoint)))
(allow worker_t anything (dir (ioctl read getattr lock search open)))
(allow domain kernel_t (process (sigchld)))

(sid kernel)
(sid security)
(sid unlabeled)
(sid file)
(sid init)
(sid any_socket)
(sid port)
(sid netif)
(sid netmsg)
(sid node)
(sid devnull)
(sidorder (kernel security unlabeled file init any_socket port netif netmsg node devnull))
(sidcontext kernel (u r kernel_t lr))
(sidcontext security (u object_r security_t lr))
(sidcontext unlabeled (u object_r unlabeled_t lr))
(sidcontext file (u object_r root_t lr))
(sidcontext init (u r kernel_t lr))
(sidcontext any_socket (u object_r unlabeled_t lr))
(sidcontext port (u object_r unlabeled_t lr))
(sidcontext netif (u object_r unlabeled_t lr))
(sidcontext netmsg (u object_r unlabeled_t lr))
(sidcontext node (u object_r unlabeled_t lr))
(sidcontext devnull (u object_r dev_t lr))

(genfscon rootfs / (u object_r root_t lr))
(genfscon proc / (u object_r proc_t lr))
(genfscon sysfs / (u object_r sysfs_t lr))
(genfscon cgroup2 / (u object_r cgroup_t lr))
(genfscon selinuxfs / (u object_r security_t lr))
(genfscon vfat / (u object_r boot_t lr))
(fsuse trans devtmpfs (u object_r dev_t lr))
(fsuse trans tmpfs (u object_r tmp_t lr))
(fsuse task pipefs (u object_r unlabeled_t lr))
(fsuse task sockfs (u object_r unlabeled_t lr))
